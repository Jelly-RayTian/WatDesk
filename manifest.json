{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.4.2",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "scripting",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://student.cs.uwaterloo.ca/*",
    "https://adfs.uwaterloo.ca/*",
    "https://uwmo.mobius.cloud/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html?side=1"
  },
  "options_page": "index.html#settings",
  "action": {
    "default_title": "WatDesk",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "host_permissions": [
    "https://learn.uwaterloo.ca/*",
    "https://app.crowdmark.com/*",
    "https://odyssey.uwaterloo.ca/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://learn.uwaterloo.ca https://app.crowdmark.com https://odyssey.uwaterloo.ca https://student.cs.uwaterloo.ca https://uwmo.mobius.cloud"
  },
  "default_locale": "en"
}
